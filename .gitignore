# ============================================================
# KIOM 연구성과 포털 — .gitignore
# Stack: Next.js 15 / Prisma / NextAuth / ES8 / MinIO / Vitest / Playwright
# ============================================================

# ─────────────────────────────────────────
# Node.js
# ─────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ─────────────────────────────────────────
# Next.js 빌드 아티팩트
# ─────────────────────────────────────────
.next/
out/
dist/
build/
next-env.d.ts
*.tsbuildinfo

# ─────────────────────────────────────────
# 환경변수 — .env.example 은 반드시 커밋할 것
# ─────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─────────────────────────────────────────
# Prisma
# ⚠️  migrations/ 는 무조건 커밋 (DB 스키마 이력 보존)
# ─────────────────────────────────────────
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal

# ─────────────────────────────────────────
# Elasticsearch (로컬 개발용 데이터)
# ─────────────────────────────────────────
elasticsearch-data/
.elasticsearch/
es-data/

# ─────────────────────────────────────────
# MinIO (로컬 개발용 스토리지)
# ─────────────────────────────────────────
minio-data/
.minio/
minio/data/

# ─────────────────────────────────────────
# Docker
# ─────────────────────────────────────────
docker-compose.override.yml
.docker/volumes/

# ─────────────────────────────────────────
# 인증서 / 시크릿 (절대 커밋 금지)
# ─────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
certs/

# ─────────────────────────────────────────
# 테스트 — Vitest
# ─────────────────────────────────────────
coverage/
.vitest-cache/

# ─────────────────────────────────────────
# 테스트 — Playwright
# ─────────────────────────────────────────
playwright-report/
playwright/.auth/
test-results/
blob-report/

# ─────────────────────────────────────────
# 업로드 파일 (로컬 테스트용)
# ─────────────────────────────────────────
uploads/
tmp/
temp/

# ─────────────────────────────────────────
# 로그
# ─────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
playwright-mcp-server.log

# ─────────────────────────────────────────
# OS
# ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ─────────────────────────────────────────
# 에디터 / IDE
# (팀 공통 설정은 커밋, 개인 로컬 설정만 제외)
# ─────────────────────────────────────────
.idea/
*.swp
*.swo
*.orig
# VSCode: 개인 설정만 제외, 프로젝트 설정(.vscode/settings.json)은 커밋 가능
.vscode/launch.json
.vscode/local.*.json

# ─────────────────────────────────────────
# Three Man Team — handoff 파일은 팀 내 공유
# SESSION-CHECKPOINT 는 로컬 상태이므로 제외
# ─────────────────────────────────────────
handoff/SESSION-CHECKPOINT.md

# ─────────────────────────────────────────
# Claude Code / Agent 설정 (API 키 포함)
# ─────────────────────────────────────────
.claude/settings.json
.agents/settings.json
